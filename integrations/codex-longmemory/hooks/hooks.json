{
  "description": "Startup-only document memory consent invitation. No legacy chat hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','document-memory-startup.mjs')).href)\"",
            "commandWindows": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','document-memory-startup.mjs')).href)\"",
            "timeout": 10,
            "statusMessage": "Checking optional document memory invitation",
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
