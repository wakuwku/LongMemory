{
    "name": "longmemory",
    "version": "1.0.0",
    "description": "LongMemory Hydrograph TypeScript package: library, CLI, self-hosted API server, and benchmark harness.",
    "license": "Apache-2.0",
    "author": "CaviraOSS",
    "homepage": "https://github.com/CaviraOSS/LongMemory#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CaviraOSS/LongMemory.git"
    },
    "bugs": {
        "url": "https://github.com/CaviraOSS/LongMemory/issues"
    },
    "keywords": [
        "ai",
        "agents",
        "memory",
        "mcp",
        "sqlite",
        "temporal"
    ],
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@11.5.2",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "longmemory": "dist/cli/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "docs",
        "LICENSE",
        "NOTICE"
    ],
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/stores/sqlite',{recursive:true});fs.copyFileSync('src/stores/sqlite/schema.sql','dist/stores/sqlite/schema.sql')\"",
        "test:unit": "node --import tsx --test src/cli/context/central_storage.test.ts src/cli/commands/porter/history_govern.test.ts src/cli/commands/porter/history_worker.test.ts src/cli/porter/adapters/codex.test.ts src/cli/porter/history_plan.test.ts src/cli/porter/history_authorization.test.ts src/cli/porter/history_redaction.test.ts src/core/central_memory/central_memory.test.ts src/core/central_memory/history_backfill.test.ts src/core/central_memory/history_publication.test.ts src/integrations/codex_hooks/codex_hooks.test.ts src/integrations/obsidian/projector.test.ts src/mcp/central_memory_tools.test.ts src/mcp/history_backfill_tool.test.ts src/mcp/history_publication_tool.test.ts src/stores/sqlite/history_publication_hardening.test.ts src/stores/sqlite/integrity.test.ts integrations/codex-longmemory/scripts/plugin-runtime.test.mjs",
        "start": "node dist/server/index.js",
        "dev": "node --import tsx src/cli/index.ts status",
        "bench": "tsx benchmarks/src/cli.ts run --providers=longmemory --datasets=smoke --no-resume",
        "bench:full": "tsx benchmarks/src/official.ts --providers=longmemory --per-category=3 --no-resume",
        "bench:ci": "tsx benchmarks/src/cli.ts run --providers=longmemory --datasets=smoke --run-id=ci-smoke --out=benchmarks/runs/ci-smoke --no-resume --require-all --gate --no-color",
        "bench:ci:full": "tsx benchmarks/src/official.ts --providers=longmemory --per-category=3 --run-id=ci-public --out=benchmarks/runs/ci-public --no-resume --require-all --gate --no-color",
        "bench:data": "tsx benchmarks/src/cli.ts data",
        "bench:public": "pnpm bench:data && pnpm bench:ci:full",
        "bench:core": "tsx benchmarks/src/cli.ts run --providers=longmemory --datasets=smoke --run-id=core-smoke --out=benchmarks/runs/core-smoke --no-resume --require-all --gate --no-color",
        "bench:quality": "node --env-file=benchmarks/comparative.env --import tsx benchmarks/src/official.ts --providers=longmemory --per-category=3 --cutoffs=5 --no-resume --require-all",
        "bench:compare": "pnpm bench:quality",
        "bench:judge": "tsx benchmarks/src/cli.ts run --providers=longmemory --datasets=smoke --answerer=openai:gpt-4.1-mini --judge=openai:gpt-4.1 --no-resume",
        "bench:judge:copilot": "tsx benchmarks/src/cli.ts run --providers=longmemory --datasets=smoke --answerer=copilot-answerer:gpt-5.6-luna --judge=copilot-judge:gpt-5.6-luna --no-resume",
        "bench:judge:codex": "pnpm bench:judge:copilot",
        "bench:typecheck": "tsc --noEmit -p benchmarks/tsconfig.json",
        "serve": "tsx src/server/index.ts",
        "extension:check": "pnpm --dir apps/vscode-extension check",
        "extension:build": "pnpm --dir apps/vscode-extension compile",
        "extension:package": "pnpm --dir apps/vscode-extension package",
        "dashboard:audit": "npm --prefix dashboard audit --audit-level=moderate",
        "integration:n8n:lint": "pnpm --dir integrations/n8n-nodes-longmemory lint",
        "integration:n8n:build": "pnpm --dir integrations/n8n-nodes-longmemory build",
        "integration:claude:validate": "claude plugin validate ./integrations/claude-code-longmemory --strict",
        "integration:check": "pnpm integration:n8n:lint && pnpm integration:n8n:build && node tools/check-integrations.mjs",
        "release:files": "node tools/check-release-files.mjs",
        "branding:apply": "node tools/branding.mjs --apply",
        "branding:check": "node tools/branding.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "release:check": "pnpm branding:check && pnpm release:files && pnpm dashboard:audit && pnpm test:unit && pnpm typecheck && pnpm extension:check && pnpm integration:check && pnpm bench:typecheck && pnpm bench:ci && pnpm build && pnpm extension:build && npm --prefix dashboard run build"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^20.19.25",
        "@types/turndown": "^5.0.6",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "yaml": "^2.8.1"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.1093.0",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "better-sqlite3": "^12.11.1",
        "mammoth": "^1.12.0",
        "pdf-parse": "^2.4.5",
        "turndown": "^7.2.4",
        "zod": "^4.4.3"
    }
}
